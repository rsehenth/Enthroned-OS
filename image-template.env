# Enthroned OS build parameters.
# The filename is kept aligned with the Universal Blue image-template Justfile
# contract (set dotenv-filename := "image-template.env").
# Upstream template: https://github.com/ublue-os/image-template (Apache-2.0)

# Output image name (OCI tag base).
IMAGE_NAME=enthroned-os

# GitHub username/organization that will own the ghcr.io/<namespace> repo.
# PLACEHOLDER ON PURPOSE: publishing stays blocked until a real namespace is
# configured by a human (ADR-0002). Values must be lowercase GitHub namespace
# rules: letters, digits and dashes only.
REPO_ORGANIZATION="SET_ME_BEFORE_PUBLISH"

IMAGE_DESC="Enthroned OS - bootc desktop image derived from Universal Blue Aurora (Fedora KDE). F1 development build."
IMAGE_KEYWORDS="bootc,oci,linux,enthroned-os"

# Development channel. Do NOT switch to stable before F1 validation completes.
DEFAULT_TAG="f1-dev"

# bootc-image-builder container used to convert OCI -> disk artifacts.
BIB_IMAGE="ghcr.io/osbuild/image-builder-cli:latest"
