{
  "name": "rollback-failed",
  "title": "Rollback falhou",
  "description": "Rollback explicito que termina com erro; a maquina registra a falha.",
  "steps": [
    { "delayMs": 0, "events": [
      { "source": "engine", "operationId": "check", "rawType": "engine-check-started", "phase": "FetchingInfo", "description": "Verificacao iniciada", "severity": "Info" },
      { "source": "check", "operationId": "check", "rawType": "check-no-update", "phase": "Completed", "description": "Nenhuma atualizacao disponivel", "severity": "Info" },
      { "source": "engine", "operationId": "bootc-status", "rawType": "bootc-status-ok", "phase": "Initializing", "description": "Status de deployment consultado", "severity": "Info" }
    ], "expectState": "upToDate" },
    { "delayMs": 300, "events": [
      { "source": "engine", "operationId": "rollback-2", "rawType": "engine-rollback-started", "phase": "Initializing", "description": "Rollback iniciado via enthroned-rollback.service", "severity": "Info" }
    ], "expectState": "rollingBack" },
    { "delayMs": 400, "events": [
      { "source": "system", "operationId": "rollback-2", "rawType": "rollback-failed", "phase": "Failed", "description": "Rollback terminou com erros (codigo 1)", "severity": "Error" }
    ], "expectState": "failed" }
  ],
  "finalState": "failed"
}
